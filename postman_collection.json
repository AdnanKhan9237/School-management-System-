{
	"info": {
		"_postman_id": "school-saas-api-v1",
		"name": "School Management SaaS API (V1)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "Super Admin Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@schoolsaas.com\",\n  \"password\": \"Admin@123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/super-admin/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "super-admin", "login"]
						}
					}
				}
			]
		},
		{
			"name": "School Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Tenant", "value": "demo" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"principal@demo.com\",\n  \"password\": \"Principal@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000"
		}
	]
}
